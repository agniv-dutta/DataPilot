# ---------------------------------------------------------------------------
# AI Data Analyst — backend environment
# Copy to `.env` and fill in the values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# App
# Name shown in the FastAPI metadata and docs.
APP_NAME=AI Data Analyst
# Deployment label; informational only.
ENVIRONMENT=development
# Debug mode setting (currently informational; keep false in production).
DEBUG=false
# Python logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM provider implementation. Currently supported provider: groq.
LLM_PROVIDER=groq
# Groq API key; leave blank to run the app without chat completions.
GROQ_API_KEY=
# Tool-calling models: openai/gpt-oss-120b (default), openai/gpt-oss-20b,
# qwen/qwen3.8-27b, allam-2-7b. List yours with: GET /openai/v1/models.
GROQ_MODEL=openai/gpt-oss-120b
# Groq API base URL (the client appends the OpenAI-compatible path).
GROQ_BASE_URL=https://api.groq.com
# Maximum tokens requested for each model completion.
LLM_MAX_TOKENS=4096

# Uploads / datasets
# Maximum accepted upload size in bytes (25 MiB by default).
MAX_UPLOAD_BYTES=26214400
# Maximum number of uploaded datasets in a session.
MAX_FILES_PER_SESSION=20
# Largest dataset row count eligible for full profiling.
MAX_ROWS_PROFILED=200000
# Number of rows included in dataset schema samples.
SAMPLE_ROWS=5

# Sandbox limits (seconds / rows)
# Wall-clock limit for a SQL query, in seconds.
SQL_TIMEOUT_SECONDS=10
# Wall-clock limit for restricted pandas code, in seconds.
PANDAS_TIMEOUT_SECONDS=10
# Maximum rows returned from a sandbox query.
MAX_RESULT_ROWS=10000
# Maximum cached SQL results per session.
MAX_QUERY_CACHE=128

# Agent
# Maximum LLM/tool-calling rounds per user request.
AGENT_MAX_ITERATIONS=6
# Approximate combined conversation and tool-result context budget in tokens.
MEMORY_TOKEN_BUDGET=8000
# Maximum characters kept in one LLM-facing tool result.
TOOL_RESULT_BUDGET_CHARS=6000
# Maximum rows retained in LLM-facing query tool results.
LLM_RESULT_ROWS=50

# Ops
# Maximum state-changing requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=60
