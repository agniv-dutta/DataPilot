# ---------------------------------------------------------------------------
# AI Data Analyst — backend environment
# Copy to `.env` and fill in the values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# App
APP_NAME=AI Data Analyst
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM provider: Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
# Tool-calling models: openai/gpt-oss-120b (default), openai/gpt-oss-20b,
# qwen/qwen3.8-27b, allam-2-7b. List yours with: GET /openai/v1/models.
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=4096

# API key — read from env only.
GROQ_API_KEY=

# Uploads / datasets
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_SESSION=20
MAX_ROWS_PROFILED=200000
SAMPLE_ROWS=5

# Sandbox limits (seconds / rows)
SQL_TIMEOUT_SECONDS=10
PANDAS_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=10000
MAX_QUERY_CACHE=128

# Agent
AGENT_MAX_ITERATIONS=6
MEMORY_TOKEN_BUDGET=8000

# Ops
RATE_LIMIT_PER_MINUTE=60
