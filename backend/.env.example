# ---------------------------------------------------------------------------
# AI Data Analyst — backend environment
# Copy to `.env` and fill in the values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# App
APP_NAME=AI Data Analyst
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM provider: "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# API keys — read from env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Uploads / datasets
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_SESSION=20
MAX_ROWS_PROFILED=200000
SAMPLE_ROWS=5

# Sandbox limits (seconds / rows)
SQL_TIMEOUT_SECONDS=10
PANDAS_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=10000
MAX_QUERY_CACHE=128

# Agent
AGENT_MAX_ITERATIONS=6
MEMORY_TOKEN_BUDGET=8000

# Ops
RATE_LIMIT_PER_MINUTE=60
